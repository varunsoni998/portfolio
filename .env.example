# AI Lab configuration
#
# IMPORTANT: everything in a VITE_ variable is bundled into the client
# JavaScript and is publicly visible — never put a secret here.
# OPENROUTER_API_KEY, ComfyUI credentials, database passwords, and any
# other secret belong ONLY on the backend, as plain (non-VITE_) server
# environment variables that the frontend never sees.

# When true (the default if unset), every AI Lab tool simulates its
# response instead of calling a real backend. Every mock result is
# labeled "Demo" in the UI. Flip to false once a real backend exists.
VITE_AI_LAB_MOCK=true

# Public backend base URL (safe to expose — it's just an address, not a
# credential). Leave empty while there's no backend yet.
VITE_AI_LAB_API_BASE=
